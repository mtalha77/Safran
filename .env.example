# Supabase SSR
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use this instead of the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only seed/order credentials. Never expose these as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: promote this existing Auth user to admin during seeding.
SUPABASE_ADMIN_EMAIL=

# Stripe (CHF, TWINT + cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email receipts via Resend
RESEND_API_KEY=
RESEND_FROM=Safran Romanshorn <bestellung@safran-solothurn.ch>

# Public restaurant contact
NEXT_PUBLIC_RESTAURANT_PHONE=+41326235959
NEXT_PUBLIC_RESTAURANT_EMAIL=info@safran-solothurn.ch

# Kitchen / counter bill printing (Epson TM-T20IV / TM-T88VII)
# Providers: log (dev, no hardware) | epson_epos | raw_tcp
PRINTER_PROVIDER=log
# ePOS example: http://192.168.1.50/cgi-bin/epos/service.cgi?devid=local_printer&timeout=10000
EPSON_EPOS_URL=
# Raw ESC/POS over port 9100 (server must reach the printer network)
EPSON_PRINTER_HOST=
EPSON_PRINTER_PORT=9100
# Protects GET/POST /api/print/process for cron retries
PRINT_WORKER_SECRET=
